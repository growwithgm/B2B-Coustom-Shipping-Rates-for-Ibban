# Copy to .env for the local admin scripts (register-carrier, activate-function,
# check-weights). The Render service itself only needs SHOP_DOMAIN and
# CALLBACK_SECRET (set those in the Render dashboard, not here).

# The store's *.myshopify.com domain (Shopify admin > Settings > Domains).
SHOP_DOMAIN=your-store.myshopify.com

# ── Admin API auth (current Dev Dashboard flow) ───────────────────────────────
# The scripts fetch a 24-hour Admin token automatically via the OAuth
# CLIENT CREDENTIALS GRANT — no manual token reveal exists for CLI-managed apps.
# Both values come from: dev.shopify.com/dashboard → Apps → GN B2B Shipping → Settings
# ORDER MATTERS: this only works AFTER `shopify app deploy` (scopes registered)
# AND after the app is installed on the store (scopes granted).
SHOPIFY_CLIENT_ID=9ea53daf3e8d6f84fc35c4d4c6cf1670
SHOPIFY_CLIENT_SECRET=

# Optional escape hatch: paste a ready-made Admin token (e.g. from a legacy
# admin-created custom app) to skip the grant. Leave commented normally.
#ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the Render web service (no trailing slash).
APP_URL=https://ibban-b2b-shipping.onrender.com

# Random secret segment for the callback URL. Generate with: openssl rand -hex 16
# MUST be identical to the CALLBACK_SECRET env var on Render.
CALLBACK_SECRET=

# Admin API version used by the scripts (override if needed).
SHOPIFY_API_VERSION=2026-01
