# Copy to .env for running the local admin scripts (register-carrier,
# activate-function, check-weights). The Render service itself only needs
# SHOP_DOMAIN and CALLBACK_SECRET (set those in the Render dashboard).

# The store's *.myshopify.com domain (find it in Shopify admin > Settings > Domains).
SHOP_DOMAIN=your-store.myshopify.com

# Admin API access token of the custom app (shpat_...). Required scopes:
#   write_shipping, write_delivery_customizations, read_products, read_inventory
ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the Render web service (no trailing slash).
APP_URL=https://ibban-b2b-shipping.onrender.com

# Random secret segment for the callback URL. Generate with: openssl rand -hex 16
# MUST be identical to the CALLBACK_SECRET env var on Render.
CALLBACK_SECRET=

# Admin API version used by the scripts (override if needed).
SHOPIFY_API_VERSION=2026-01
